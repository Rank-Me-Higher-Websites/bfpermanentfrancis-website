# Copy to .env on the server. server/api.cjs reads this file directly if present,
# and the systemd unit loads it as an EnvironmentFile. Never commit the real one.

# Postgres. The original database was Replit's built-in instance and did not move
# to the VPS — create a new one and load deploy/schema.sql into it.
DATABASE_URL=postgres://bfpf:CHANGE_ME@127.0.0.1:5432/bfpf

# Teamup calendar. Both are required for availability and calendar sync; without
# them the API starts, logs a warning, and treats the calendar as empty.
# The previous key shipped inside publicly downloadable source — generate new
# credentials rather than reusing anything found in this repo's history.
TEAMUP_API_KEY=
TEAMUP_TOKEN=

# Bearer token guarding GET /api/leads. If unset the server generates a random
# one at boot and prints it, which means it changes on every restart.
LEADS_ADMIN_TOKEN=

# Port for server/index.cjs. Must match the reverse_proxy target in the Caddyfile.
PORT=5000
